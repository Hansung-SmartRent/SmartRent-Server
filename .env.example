# SmartRent 백엔드 환경변수 목록
# 사용법: 이 파일을 .env로 복사한 뒤 값을 채웁니다. .env는 레포에 올라가지 않습니다.
#   맥:     cp .env.example .env
#   윈도우: copy .env.example .env
# 프로젝트 루트에서 실행하면 Spring이 properties 형식으로 읽습니다. docker compose도 같은 파일을 읽습니다.
# 따옴표·export 없이 이름=값으로 작성합니다. 경로는 / 사용을 권장합니다.
# DB·JWT 등 필수값은 채워야 합니다. 외부 연동은 비활성화할 수 있습니다(docs/외부연결.md).
# 실제 비밀값은 팀 채팅이 아니라 직접 전달하거나 각자 발급합니다(docs/시작하기.md 9절).

# ── 실행 설정 ──
# local: 개발용(가짜 데이터 넣기, 메일 대신 로그), prod: AWS 서버
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
TZ=Asia/Seoul

# ── DB (MySQL 9.7) ── 이슈 B1-01·B1-02
# Docker MySQL을 켤 컴퓨터 쪽 포트. 이미 다른 MySQL이 3306을 쓰면 3307로 바꾸고 DB_URL의 포트도 같이 바꿈
DB_HOST_PORT=3306
DB_URL=jdbc:mysql://localhost:3306/smartrent?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=smartrent
DB_PASSWORD=

# ── 처음 데이터 ── 이슈 B1-03
# local 프로필은 서버를 켤 때 fixtures의 기자재·가짜 계정·공휴일을 빈 표에 자동으로 넣습니다.
# prod(AWS)에서 빈 DB에 기자재와 관리자 계정만 넣을 때만 true로 켜고, 넣은 뒤에는 false로 돌립니다.
SEED_PROD_ENABLED=false
# prod에서 만들 관리자 계정. 비밀번호는 8자 이상, 팀 채팅에 올리지 않습니다.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── 로그인 토큰(JWT) ── 이슈 B1-04
# 32바이트 이상 임의 문자열. 개발용과 운영용을 다르게 씁니다.
JWT_SECRET=
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14

# ── 인증 메일(Gmail SMTP) ── 이슈 B1-05, docs/외부연결.md 1절
# MAIL_ENABLED=false면 메일을 보내지 않고 서버 로그에 인증번호를 찍습니다(local에서만).
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
# Google 계정의 "앱 비밀번호" 16자리. 계정 비밀번호가 아닙니다.
MAIL_PASSWORD=

# ── 푸시 알림(FCM) ── 이슈 B2-13, docs/외부연결.md 2절
# 키 파일은 레포 밖에 두고 경로만 적습니다.
FCM_ENABLED=false
FCM_CREDENTIALS_PATH=

# ── AI 추천(Gemini API) ── 이슈 B1-21, docs/외부연결.md 3절
# Gemini 무료 등급으로 시작합니다. B1-21에서 무료 지원·호출을 확인한 모델 ID를 채웁니다.
# AI_ENABLED=true일 때 GEMINI_API_KEY와 AI_MODEL_ID는 필수입니다.
AI_ENABLED=false
GEMINI_API_KEY=
AI_MODEL_ID=

# ── 공휴일(공공데이터포털 특일 정보) ── 이슈 B1-19, docs/외부연결.md 4절
HOLIDAY_SYNC_ENABLED=false
HOLIDAY_API_KEY=

# ── 사진 저장 ── 이슈 B1-08, docs/외부연결.md 5절
# local: 레포 밖 폴더에 저장, s3: AWS S3에 저장
STORAGE_MODE=local
# local일 때 저장 폴더. 비우면 홈 폴더의 smartrent-uploads(레포 안 폴더는 쓰지 않음)
STORAGE_LOCAL_DIR=
# s3일 때 필수(비어 있으면 서버가 켜지지 않음)
S3_BUCKET=
AWS_REGION=ap-northeast-2
# EC2에서는 IAM 역할을 쓰므로 액세스 키를 여기에 넣지 않습니다.
